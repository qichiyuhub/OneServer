# 由 oneserver podman compose 生成 —— 不要手改，下次 up 会按模板重新渲染并覆盖。
#
# 为什么 compose 项目要包一层 systemd（D196）：`podman compose` 起的容器不是
# Quadlet 托管的，重启机器不会自己回来，而且在 oneserver podman ls 里会显示成
# 「本工具托管：否」。包一层之后开机自启、依赖顺序、失败处理全交给 systemd。
#
# 项目的真相在 %%DIR%% 那个目录里 —— 本工具不复制、不改写它的任何文件。

[Unit]
Description=Compose 项目 %%NAME%%（oneserver 托管）
Documentation=man:podman-compose(1)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%%DIR%%

# provider 钉死在这里，不靠 podman 的自动发现（D203）：podman 的默认顺序是
# docker-compose 优先，而 Ubuntu 24.04 源里的 docker-compose 是已经死掉的
# Python v1（1.29.2），它不认现代 compose 规范 —— 自动发现会挑中它，
# 表现为「装了 docker-compose 反而更不兼容」，且用户完全看不出来。
Environment=PODMAN_COMPOSE_PROVIDER=%%PROVIDER%%

ExecStart=%%PODMAN%% compose -f %%FILE%% -p %%NAME%% up -d

# ExecStop 是 stop 不是 down（D197）：systemctl restart 会触发
# ExecStop → ExecStart，用 down 则每次重启都删掉容器与匿名卷 ——
# restart 一次就丢数据。要真正删容器走 oneserver podman compose down。
ExecStop=%%PODMAN%% compose -f %%FILE%% -p %%NAME%% stop

# 第一次 up 要拉镜像，900 秒是给它的
TimeoutStartSec=900
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
